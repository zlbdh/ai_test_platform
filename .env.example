# ============================================================
# AI Test Platform - 环境变量配置模板
# 复制为 .env 并填入你的实际值
# ============================================================

# ── LLM 配置 ──
LLM_PROVIDER=openai                      # openai | gemini | deepseek | chatglm | claude
LLM_MODEL=gpt-4o                         # 模型名称
OPENAI_API_KEY=your-openai-api-key-here      # 必填
OPENAI_BASE_URL=https://api.openai.com/v1 # API 网关（可选）
# OPENAI_MODEL=gpt-4o                    # 向后兼容

# ── 多智能体协同模型 ──
# PLANNER_MODEL=                         # 规划器模型（默认继承 LLM_MODEL）
# EXECUTOR_MODEL=                        # 执行器模型

# ── Gemini 配置 ──
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# ── DeepSeek 配置 ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# ── ChatGLM (智谱AI) 配置 ──
# CHATGLM_API_KEY=
# CHATGLM_MODEL=glm-4
# CHATGLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Anthropic Claude 配置 ──
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ── Vision ──
ENABLE_VISION=true
VISION_MODEL=gemini-1.5-flash

# ── 测试目标 ──
TARGET_URL=http://localhost:3000
API_BASE_URL=http://localhost:8020

# ── 浏览器 ──
BROWSER_TYPE=chromium                     # chromium | firefox | webkit
HEADLESS=false
CHROME_DEBUG_PORT=8030

# ── 超时 ──
UI_TIMEOUT=30000                          # 毫秒
API_TIMEOUT=120                           # 秒
LLM_TIMEOUT=600                           # 秒（Thinking 模型需更长）

# ── 数据库（可选） ──
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=test_db
# DB_USER=root
# DB_PASSWORD=

# ── RAG 知识库 ──
ENABLE_RAG=true
EMBEDDING_MODEL=text-embedding-3-small

# ── 安全 ──
# SYSTEM_API_KEY=                         # 系统管理 API 密钥（保护 /api/system/* 端点）
# CORS_ORIGINS=http://localhost:8010      # 允许的 CORS 来源，逗号分隔

# ── 通知（可选） ──
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TYPE=notification_platform
