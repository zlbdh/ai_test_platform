# ============================================================
# AI Test Platform - Environment Variable Template
# Copy to .env and enter your actual values
# ============================================================

# ── LLM configuration ──
LLM_PROVIDER=openai                      # openai | gemini | deepseek | chatglm | claude
LLM_MODEL=gpt-4o                         # Model name
OPENAI_API_KEY=your-openai-api-key-here      # Required
OPENAI_BASE_URL=https://api.openai.com/v1 # API gateway (optional)
# OPENAI_MODEL=gpt-4o                    # Backward compatibility

# ── Multi-agent models ──
# PLANNER_MODEL=                         # Planner model (defaults to LLM_MODEL)
# EXECUTOR_MODEL=                        # Executor model

# ── Gemini configuration ──
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# ── DeepSeek configuration ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# ── ChatGLM (Zhipu AI) configuration ──
# CHATGLM_API_KEY=
# CHATGLM_MODEL=glm-4
# CHATGLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Anthropic Claude configuration ──
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ── Vision ──
ENABLE_VISION=true
VISION_MODEL=gemini-1.5-flash

# ── Test targets ──
TARGET_URL=http://localhost:3000
API_BASE_URL=http://localhost:8020

# ── Browser ──
BROWSER_TYPE=chromium                     # chromium | firefox | webkit
HEADLESS=false
CHROME_DEBUG_PORT=8030

# ── Timeouts ──
UI_TIMEOUT=30000                          # milliseconds
API_TIMEOUT=120                           # seconds
LLM_TIMEOUT=600                           # seconds (reasoning models need more time)

# ── Database (optional) ──
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=test_db
# DB_USER=root
# DB_PASSWORD=

# ── RAG knowledge base ──
ENABLE_RAG=true
EMBEDDING_MODEL=text-embedding-3-small

# ── Security ──
# SYSTEM_API_KEY=                         # System administration API key (protects /api/system/* endpoints)
# CORS_ORIGINS=http://localhost:8010      # Allowed CORS origins, comma-separated

# ── Notifications (optional) ──
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TYPE=notification_platform
