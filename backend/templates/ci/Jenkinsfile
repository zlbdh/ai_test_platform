# ============================================================================
# AI Test Platform — Jenkinsfile template
#
# Usage:
# 1. Copy this file to your project root
# 2. Configure the AITEST_API_URL environment variable in Jenkins
# 3. Run the pipeline
# ============================================================================

pipeline {
    agent any

    environment {
        AITEST_API_URL = credentials('aitest-api-url') ?: 'http://localhost:8020'
    }

    parameters {
        string(name: 'TEST_URL', defaultValue: 'https://example.com', description: 'Test target URL')
        string(name: 'TEST_GOAL', defaultValue: 'Verify that the home page loads correctly', description: 'Test instructions')
        choice(name: 'TEST_MODE', choices: ['smart', 'fast', 'deep'], description: 'Test mode')
    }

    stages {
        stage('🏥 Health check') {
            steps {
                sh 'python aitest.py health'
            }
        }

        stage('🚀 AI tests') {
            steps {
                sh """
                    python aitest.py run \\
                        --url "${params.TEST_URL}" \\
                        --goal "${params.TEST_GOAL}" \\
                        --mode ${params.TEST_MODE} \\
                        --wait \\
                        --timeout 120 \\
                        --output junit
                """
            }
            post {
                always {
                    junit 'test-results-*.xml'
                    archiveArtifacts artifacts: 'test-results-*.xml', allowEmptyArchive: true
                }
            }
        }

        stage('📊 Generate reports') {
            steps {
                sh 'python aitest.py report'
                sh 'python aitest.py analytics'
            }
        }
    }

    post {
        failure {
            echo '❌ AI tests failed!'
        }
        success {
            echo '✅ AI tests passed!'
        }
    }
}
